{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/referral/:slug", "destination": "/Dashboard/dashboard2.html" },
    { "source": "/Registration-form/:file", "destination": "/Registration-form/:file" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|webp|ico|svg|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
